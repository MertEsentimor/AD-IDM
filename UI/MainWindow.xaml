<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AD &amp; Exchange Kullanıcı Yöneticisi"
        Width="1380" Height="920" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <ScrollViewer x:Name="svRoot" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
    <Grid x:Name="grdRoot">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Simge şeridi -->
        <Border x:Name="bdRail" Style="{DynamicResource ChromePane}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Width="36" Height="36" CornerRadius="3" Background="{DynamicResource AccentBrush}" Margin="0,12,0,14">
                    <TextBlock Text="&#xE716;" Style="{DynamicResource Glyph}" Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,10">
                    <Button x:Name="btnView" AutomationProperties.Name="Görünüm: arayüz ölçeği" Style="{DynamicResource ChromeIconButton}" Content="&#xE71E;" HorizontalAlignment="Center" Margin="0,0,0,4"
                            ToolTip="Görünüm: arayüz ölçeği (Ctrl + / Ctrl - / Ctrl 0)"/>
                    <Button x:Name="btnTheme" AutomationProperties.Name="Açık / koyu tema" Style="{DynamicResource ChromeIconButton}" Content="&#xE708;" HorizontalAlignment="Center"
                            ToolTip="Açık / koyu tema (seçim hatırlanır)"/>
                    <Popup x:Name="popView" PlacementTarget="{Binding ElementName=btnView}" Placement="Right" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border TextElement.Foreground="{DynamicResource TextBrush}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="16,14,16,16" Margin="8,0,8,8" Width="276">
                            <StackPanel>
                                <TextBlock Text="Görünüm" Style="{DynamicResource SectionTitle}"/>
                                <TextBlock Text="Arayüz ölçeği" Style="{DynamicResource FieldLabel}"/>
                                <Border Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource LineSubtleBrush}" BorderThickness="1" CornerRadius="3" Padding="4">
                                    <DockPanel>
                                        <Button x:Name="btnScaleDown" AutomationProperties.Name="Küçült" DockPanel.Dock="Left" Style="{DynamicResource IconButton}" Content="&#xE738;"/>
                                        <Button x:Name="btnScaleUp" AutomationProperties.Name="Büyüt" DockPanel.Dock="Right" Style="{DynamicResource IconButton}" Content="&#xE710;"/>
                                        <TextBlock x:Name="txtScaleValue" Text="%100" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                                <CheckBox x:Name="chkScaleAuto" Content="Ekrana göre otomatik" Margin="0,12,0,0"
                                          ToolTip="4K ve büyük ekranlarda yazılar otomatik büyütülür; küçük ekranlarda %100 kalır"/>
                                <TextBlock x:Name="txtScaleInfo" Style="{DynamicResource HintText}" Margin="0,8,0,0"/>
                                <Rectangle Height="1" Fill="{DynamicResource LineSubtleBrush}" Margin="0,12,0,10"/>
                                <TextBlock Style="{DynamicResource HintText}" Text="Ctrl + fare tekerleği ile de yakınlaştırabilirsiniz. Ctrl 0 otomatiğe döner."/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
                <StackPanel>
                    <RadioButton x:Name="navHome" GroupName="Navigation" Style="{DynamicResource NavRailButton}" Tag="&#xE80F;" Content="Ana Sayfa" IsChecked="True"/>
                    <RadioButton x:Name="navUsers" GroupName="Navigation" Style="{DynamicResource NavRailButton}" Tag="&#xE716;" Content="Kullanıcılar"/>
                    <RadioButton x:Name="navLeave" GroupName="Navigation" Style="{DynamicResource NavRailButton}" Tag="&#xE787;" Content="İzin Planı"/>
                    <RadioButton x:Name="navPst" GroupName="Navigation" Style="{DynamicResource NavRailButton}" Tag="&#xE896;" Content="PST"/>
                    <RadioButton x:Name="navDisabled" GroupName="Navigation" Style="{DynamicResource NavRailButton}" Tag="&#xE8F8;" Content="Devre Dışı"/>
                    <RadioButton x:Name="navReports" GroupName="Navigation" Style="{DynamicResource NavRailButton}" Tag="&#xE9F9;" Content="Raporlar"/>
                    <RadioButton x:Name="navSettings" GroupName="Navigation" Style="{DynamicResource NavRailButton}" Tag="&#xE713;" Content="Ayarlar"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Üst komut çubuğu -->
            <Border Style="{DynamicResource ChromePane}" BorderThickness="0,0,0,1" Padding="12,9">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="bdAdPill" Style="{DynamicResource ChromePill}" Margin="0,0,8,0" ToolTip="{Binding Text, ElementName=txtAdStatus}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="elAd" Width="8" Height="8" Fill="{DynamicResource StatusNeutralBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtAdStatus" Text="AD: kontrol ediliyor" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="bdExPill" Style="{DynamicResource ChromePill}" Margin="0,0,4,0" ToolTip="{Binding Text, ElementName=txtExStatus}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="elEx" Width="8" Height="8" Fill="{DynamicResource StatusNeutralBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtExStatus" Text="Exchange: bağlı değil" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="btnConnection" AutomationProperties.Name="Exchange bağlantısı" Style="{DynamicResource ChromeIconButton}" Content="&#xE70D;" ToolTip="Exchange bağlantısı"/>
                        <Popup x:Name="popConnection" PlacementTarget="{Binding ElementName=btnConnection}" Placement="Bottom" HorizontalOffset="-284" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border TextElement.Foreground="{DynamicResource TextBrush}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="16,14,16,16" Margin="0,4,8,8" Width="320">
                                <StackPanel x:Name="pnlExchangeBar">
                                    <TextBlock x:Name="lblExchangeBar" Text="Exchange bağlantısı" Style="{DynamicResource SectionTitle}"/>
                                    <TextBlock Text="Ortam" Style="{DynamicResource FieldLabel}"/>
                                    <ComboBox x:Name="cmbExMode" AutomationProperties.Name="Exchange ortamı" SelectedIndex="0" Margin="0,0,0,12">
                                        <ComboBoxItem Content="Bağlantı yok (yalnızca AD)"/>
                                        <ComboBoxItem Content="Exchange On-Premises"/>
                                    </ComboBox>
                                    <StackPanel x:Name="pnlOnPrem" Visibility="Collapsed" Margin="0,0,0,12">
                                        <TextBlock Text="Sunucu" Style="{DynamicResource FieldLabel}"/>
                                        <ComboBox x:Name="cmbExServer" AutomationProperties.Name="Exchange sunucusu" IsEditable="True"
                                                  ToolTip="Exchange sunucusu FQDN (AD yapılandırmasından otomatik bulunur)"/>
                                    </StackPanel>
                                    <Button x:Name="btnExConnect" Tag="&#xE71B;" Content="Bağlan" IsEnabled="False"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                    <Button x:Name="btnPane" DockPanel.Dock="Left" AutomationProperties.Name="Sonuç listesi" Style="{DynamicResource ChromeIconButton}" Content="&#xE700;" Margin="0,0,8,0" Visibility="Collapsed"
                            ToolTip="Sonuç listesini aç / kapat (Ctrl+B)"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBox x:Name="txtSearch" Style="{DynamicResource ChromeSearchBox}" Width="380" Tag="Kişi ara (Ctrl+K)" AutomationProperties.Name="Kullanıcı ara"
                                 ToolTip="SamAccountName, Display Name, UPN veya e-posta ile arayın (Enter)"/>
                        <Button x:Name="btnSearch" AutomationProperties.Name="Kullanıcı Ara" Style="{DynamicResource ChromeIconButton}" Content="&#xE721;" Margin="4,0,0,0" ToolTip="Ara"/>
                        <Button x:Name="btnOuSearch" AutomationProperties.Name="OU'ya göre listele" Style="{DynamicResource ChromeIconButton}" Content="&#xE8B7;"
                                ToolTip="OU'ya göre listele (Ctrl+O): OU ağacından seçin, altındaki tüm kullanıcılar listelensin"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Sayfalar -->
            <Grid Grid.Row="1">
                <DockPanel x:Name="pageHome">
                    <DockPanel DockPanel.Dock="Top" Margin="24,20,24,12">
                        <Button x:Name="btnHomeRefresh" DockPanel.Dock="Right" VerticalAlignment="Center" Tag="&#xE72C;" Content="Yenile"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Ana sayfa" Style="{DynamicResource TitleText}"/>
                            <TextBlock x:Name="txtHomeStatus" Text="Özet okunuyor..." Style="{DynamicResource SubtitleText}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="24,0,24,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{DynamicResource Card}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Kilitli hesaplar" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock x:Name="txtHomeLockedCount" Text="–" FontFamily="{DynamicResource HeadingFont}" FontSize="34" FontWeight="SemiBold" Margin="0,4,0,2"/>
                                <TextBlock Text="PDC Emulator'a göre şu an kilitli" Style="{DynamicResource HintText}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{DynamicResource Card}" Margin="8,0,8,0">
                            <StackPanel>
                                <TextBlock x:Name="txtHomeExpiringLabel" Text="Parolası 7 gün içinde dolacak" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock x:Name="txtHomeExpiringCount" Text="–" FontFamily="{DynamicResource HeadingFont}" FontSize="34" FontWeight="SemiBold" Margin="0,4,0,2"/>
                                <TextBlock Text="Etkin, süresi dolan parolalı hesaplar" Style="{DynamicResource HintText}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{DynamicResource Card}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Devre dışı kullanıcılar" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock x:Name="txtHomeDisabledCount" Text="–" FontFamily="{DynamicResource HeadingFont}" FontSize="34" FontWeight="SemiBold" Margin="0,4,0,2"/>
                                <TextBlock x:Name="txtHomeDisabledDetail" Text=" " Style="{DynamicResource HintText}" TextWrapping="Wrap"/>
                                <Button x:Name="btnHomeDisabled" Tag="&#xE8A7;" Content="Devre Dışı sayfasını aç" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid Margin="24,0,24,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{DynamicResource Card}" Padding="0" Margin="0,0,8,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Kilitli hesaplar" Style="{DynamicResource SectionTitle}" Margin="18,14,18,4"/>
                                <TextBlock x:Name="txtHomeLockedEmpty" DockPanel.Dock="Top" Text="Kilitli hesap yok." Style="{DynamicResource HintText}" Margin="18,0,18,12" Visibility="Collapsed"/>
                                <ListBox x:Name="lstHomeLocked" BorderThickness="0" Background="Transparent" Padding="6,0,6,8" HorizontalContentAlignment="Stretch"
                                         ItemContainerStyle="{DynamicResource ListItem}" ItemTemplate="{DynamicResource UserRowTemplate}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" ToolTip="Çift tıklayınca kullanıcı açılır"/>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{DynamicResource Card}" Padding="0" Margin="8,0,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" x:Name="txtHomeExpiringTitle" Text="Parolası 7 gün içinde dolacaklar" Style="{DynamicResource SectionTitle}" Margin="18,14,18,4"/>
                                <TextBlock x:Name="txtHomeExpiringEmpty" DockPanel.Dock="Top" Text="Yakında parolası dolacak kullanıcı yok." Style="{DynamicResource HintText}" Margin="18,0,18,12" Visibility="Collapsed"/>
                                <ListBox x:Name="lstHomeExpiring" BorderThickness="0" Background="Transparent" Padding="6,0,6,8" HorizontalContentAlignment="Stretch"
                                         ItemContainerStyle="{DynamicResource ListItem}" ItemTemplate="{DynamicResource UserRowTemplate}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" ToolTip="Çift tıklayınca kullanıcı açılır"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </DockPanel>
                <Grid x:Name="pageUsers" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="colResults" Width="280"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="bdResults" Style="{DynamicResource SidePane}" BorderThickness="0,0,1,0">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="16,12,10,8">
                                <Button x:Name="btnNewUser" DockPanel.Dock="Right" AutomationProperties.Name="Kullanıcı Ekle" Style="{DynamicResource IconButton}" Content="&#xE8FA;" ToolTip="Kullanıcı Ekle"/>
                                <Border DockPanel.Dock="Right" Style="{DynamicResource Badge}" Margin="0,0,4,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="txtResultCount" Text="0" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                                </Border>
                                <TextBlock x:Name="txtResultsTitle" Text="Arama sonuçları" FontFamily="{DynamicResource HeadingFont}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <Grid>
                                <ListBox x:Name="lstResults" BorderThickness="0" Background="Transparent" Padding="0,0,0,6"
                                         ItemContainerStyle="{DynamicResource ListItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding SamAccountName}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="txtResultsEmpty" Text="Sonuç yok" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <DockPanel x:Name="pnlDetails" Grid.Column="1">
                        <!-- Profil başlığı -->
                        <Border x:Name="bdPerson" Visibility="{Binding Visibility, ElementName=pnlTabs}" DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,14">
                            <StackPanel>
                                <DockPanel>
                                    <Grid DockPanel.Dock="Left" Width="52" Height="52" Margin="0,0,14,0" VerticalAlignment="Top">
                                        <Ellipse x:Name="elPhoto" Fill="{DynamicResource StatusNeutralBrush}"/>
                                        <TextBlock x:Name="txtInitials" Text="?" Foreground="{DynamicResource OnAccentBrush}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid x:Name="pnlProfileDates" DockPanel.Dock="Right" Margin="20,0,0,0" VerticalAlignment="Top" MinWidth="220">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Son oturum" Style="{DynamicResource InfoLabel}" Margin="0,2,12,6"/>
                                        <StackPanel Grid.Column="1" Margin="0,0,0,6">
                                            <TextBlock x:Name="txtLastLogon" Text="-" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="txtLastLogonDetail" Text="" Style="{DynamicResource InfoLabel}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Text="Parola bitiş" Style="{DynamicResource InfoLabel}" Margin="0,2,12,0"/>
                                        <StackPanel Grid.Row="1" Grid.Column="1">
                                            <DockPanel>
                                                <Ellipse x:Name="elPwdState" DockPanel.Dock="Left" Width="9" Height="9" Fill="{DynamicResource StatusNeutralBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="txtPwdExpire" Text="-" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            </DockPanel>
                                            <TextBlock x:Name="txtPwdExpireDetail" Text="" Style="{DynamicResource InfoLabel}"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel>
                                        <TextBlock x:Name="txtStatusName" Text="Kullanıcı seçilmedi" FontFamily="{DynamicResource HeadingFont}" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="txtStatusUpn" Text="" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,1,0,6"/>
                                        <WrapPanel>
                                            <Border x:Name="bdgEnabled" Style="{DynamicResource Badge}"><TextBlock x:Name="txtEnabled" Text="-" FontSize="12" FontWeight="SemiBold"/></Border>
                                            <Border x:Name="bdgLocked" Style="{DynamicResource Badge}"><TextBlock x:Name="txtLocked" Text="-" FontSize="12" FontWeight="SemiBold"/></Border>
                                            <Border x:Name="bdgMailbox" Style="{DynamicResource Badge}"><TextBlock x:Name="txtMailboxType" Text="-" FontSize="12" FontWeight="SemiBold"/></Border>
                                        </WrapPanel>
                                    </StackPanel>
                                </DockPanel>
                                <WrapPanel Margin="66,6,0,0">
                                    <Button x:Name="btnReload" AutomationProperties.Name="Yenile (F5)" Tag="&#xE72C;" Content="Yenile (F5)" Margin="0,0,8,0" IsEnabled="False"/>
                                    <Button x:Name="btnResetPassword" Tag="&#xE8D7;" Content="Parolayı Sıfırla..." Margin="0,0,8,0" IsEnabled="False"/>
                                    <Button x:Name="btnPhotoChange" AutomationProperties.Name="Fotoğrafı değiştir" Tag="&#xE722;" Style="{DynamicResource SubtleButton}" ToolTip="Fotoğrafı değiştir" Margin="0,0,2,0"/>
                                    <Button x:Name="btnPhotoRemove" AutomationProperties.Name="Fotoğrafı kaldır" Tag="&#xE74D;" Style="{DynamicResource SubtleButton}" ToolTip="Fotoğrafı kaldır"/>
                                </WrapPanel>
                                <Border x:Name="bdLockPanel" Style="{DynamicResource InfoBar}" Background="{DynamicResource DangerBgBrush}" BorderBrush="{DynamicResource DangerBrush}" Margin="0,12,0,0" Visibility="Collapsed">
                                    <DockPanel>
                                        <Button x:Name="btnUnlock" DockPanel.Dock="Right" Tag="&#xE785;" Content="Kilidi Aç" FontSize="12" MinHeight="28" Padding="10,3" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="txtLockDetail" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    </DockPanel>
                                </Border>
                                <Border x:Name="bdMailboxPanel" Style="{DynamicResource InfoBar}" Margin="0,12,0,0" Visibility="Collapsed">
                                    <DockPanel>
                                        <Button x:Name="btnCreateMailbox" DockPanel.Dock="Right" Content="Posta Kutusu Oluştur" FontSize="12" MinHeight="28" Padding="10,3" VerticalAlignment="Center"/>
                                        <TextBlock Text="Bu kullanıcının posta kutusu yok." TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Bekleyen değişiklikler -->
                        <Border x:Name="bdActionBar" DockPanel.Dock="Bottom" Background="{DynamicResource WarningBgBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="0,2,0,0" Padding="20,10" Visibility="Collapsed">
                            <StackPanel>
                                <ScrollViewer MaxHeight="96" Margin="0,0,0,8" VerticalScrollBarVisibility="Auto" Focusable="False">
                                    <ItemsControl x:Name="icPending" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="3" Padding="8,4" Margin="0,0,6,6" MaxWidth="320">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <DockPanel>
                                    <StackPanel x:Name="pnlActions" DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button x:Name="btnReset" AutomationProperties.Name="Değişiklikleri Geri Al" Tag="&#xE7A7;" Content="Sıfırla" Margin="0,0,8,0" IsEnabled="False" ToolTip="Kaydedilmemiş değişiklikleri geri al"/>
                                        <Button x:Name="btnUpdate" Tag="&#xE74E;" Content="Kaydet" Style="{DynamicResource PrimaryButton}" IsEnabled="False"/>
                                    </StackPanel>
                                    <Ellipse x:Name="elPending" DockPanel.Dock="Left" Width="8" Height="8" Fill="{DynamicResource WarningBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="txtPending" Text="Değişiklik yok" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <DockPanel x:Name="pnlTabs" Visibility="Collapsed">
                                <!-- Sekme grupları -->
                                <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" Padding="12,4,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="grpIdentity" GroupName="TabGroup" Style="{DynamicResource GroupTab}" Content="Kimlik" IsChecked="True"/>
                                        <RadioButton x:Name="grpLeave" GroupName="TabGroup" Style="{DynamicResource GroupTab}" Content="İzin"/>
                                        <RadioButton x:Name="grpMail" GroupName="TabGroup" Style="{DynamicResource GroupTab}" Content="Posta"/>
                                    </StackPanel>
                                </Border>
                                <TabControl x:Name="tabMain">
                                    <TabItem x:Name="tabGeneral" Header="Genel">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel MaxWidth="960" Margin="0,0,12,0">
<Border Style="{DynamicResource Section}">
<StackPanel>
<TextBlock Text="Kimlik" Style="{DynamicResource SectionTitle}"/>
<Grid>
<Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="Ad (First Name)" Style="{DynamicResource FieldLabel}"/>
                                        <TextBox x:Name="txtGivenName" AutomationProperties.Name="Ad (First Name)"/>
                                    </StackPanel>
<StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="Soyad (Last Name)" Style="{DynamicResource FieldLabel}"/>
                                        <TextBox x:Name="txtSurname" AutomationProperties.Name="Soyad (Last Name)"/>
                                    </StackPanel>
<StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3">
                                        <TextBlock Text="Görünen ad (Display Name)" Style="{DynamicResource FieldLabel}"/>
                                        <TextBox x:Name="txtDisplayName" AutomationProperties.Name="Görünen ad (Display Name)"/>
                                    </StackPanel>
<StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                                        <TextBlock Text="Açıklama (Description)" Style="{DynamicResource FieldLabel}"/>
                                        <TextBox x:Name="txtDescription" AutomationProperties.Name="Açıklama (Description)"/>
                                    </StackPanel>
</Grid>
</StackPanel>
</Border>
<Border Style="{DynamicResource Section}">
<StackPanel>
<TextBlock Text="İletişim" Style="{DynamicResource SectionTitle}"/>
<Grid>
<Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="Ofis (Office)" Style="{DynamicResource FieldLabel}"/>
