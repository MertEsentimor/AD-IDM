<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Toplu İzin" Width="1320" Height="760" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="Hdr" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="24,20,24,12">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Toplu izin" Style="{DynamicResource TitleText}"/>
                <TextBlock Style="{DynamicResource SubtitleText}" Margin="0,2,0,0" TextWrapping="Wrap"
                           Text="Resmi tatil gibi günlerde aynı izni birden çok kullanıcıya girer. Kullanıcıları OU'dan, gruptan veya aramayla ekleyin; nöbetçilerin işaretini kaldırın."/>
            </StackPanel>
        </DockPanel>
        <Border Style="{DynamicResource DialogFooter}" DockPanel.Dock="Bottom">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="btnBlClose" Content="Kapat" IsCancel="True" MinWidth="100"/>
                <Button x:Name="btnBlApply" Margin="8,0,0,0" Tag="&#xE73E;" Content="Seçililere Uygula" Style="{DynamicResource PrimaryButton}"/>
            </StackPanel>
                <TextBlock x:Name="txtBlSummary" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,12,0"/>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Left" Width="340" Style="{DynamicResource SidePane}" BorderThickness="0,0,1,0">
<ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
<StackPanel Margin="12">
<Border Style="{DynamicResource Section}">
<StackPanel>
<TextBlock Text="1. İzin bilgisi" Style="{DynamicResource SectionTitle}"/>
<TextBlock Text="İşlem" Style="{DynamicResource FieldLabel}"/>
<RadioButton Margin="0,0,0,6" x:Name="rbBlAdd" Content="İzin ekle" IsChecked="True"/>
<RadioButton Margin="0,0,0,12" x:Name="rbBlRemove" Content="İzni kaldır (tatil iptal)"/>
<TextBlock Text="İlk izin günü" Style="{DynamicResource FieldLabel}"/>
<DatePicker x:Name="dpBlStart" AutomationProperties.Name="İlk izin günü"/>
<TextBlock Text="İşe başlangıç tarihi (hesaplar bu gün 00:00'da açılır)" Style="{DynamicResource FieldLabel}" TextWrapping="Wrap"/>
<DatePicker x:Name="dpBlEnd" AutomationProperties.Name="İşe başlangıç tarihi" ToolTip="Kişilerin işe döneceği gün. Hesaplar bu günün 00:00'ında açılır."/>
<TextBlock Text="Kapanış saati" Style="{DynamicResource FieldLabel}"/>
<ComboBox Margin="0,0,0,12" x:Name="cmbBlStartTime" AutomationProperties.Name="Kapanış saati" IsEditable="True" SelectedIndex="0"
                                      ToolTip="Girmezseniz hesaplar ilk gün 00:00'da kapanır. Arife gibi yarım günlerde ör. 13:00 seçin. Listede olmayan saati SS:dd olarak yazabilirsiniz.">
                                <ComboBoxItem Content="Tam gün (00:00)"/>
                                <ComboBoxItem Content="08:00"/>
                                <ComboBoxItem Content="09:00"/>
                                <ComboBoxItem Content="10:00"/>
                                <ComboBoxItem Content="11:00"/>
                                <ComboBoxItem Content="12:00"/>
                                <ComboBoxItem Content="13:00"/>
                                <ComboBoxItem Content="14:00"/>
                                <ComboBoxItem Content="15:00"/>
                                <ComboBoxItem Content="16:00"/>
                                <ComboBoxItem Content="17:00"/>
                                <ComboBoxItem Content="18:00"/>
                            </ComboBox>
<TextBlock Text="Açılış saati" Style="{DynamicResource FieldLabel}"/>
<ComboBox Margin="0,0,0,12" x:Name="cmbBlEndTime" AutomationProperties.Name="Açılış saati" IsEditable="True" SelectedIndex="0"
                                      ToolTip="Girmezseniz hesaplar işe başlangıç günü 00:00'da açılır. Saat seçilirse işe başlangıç günü o saatte açılır. Listede olmayan saati SS:dd olarak yazabilirsiniz.">
                                <ComboBoxItem Content="Tam gün (00:00)"/>
                                <ComboBoxItem Content="08:00"/>
                                <ComboBoxItem Content="09:00"/>
                                <ComboBoxItem Content="10:00"/>
                                <ComboBoxItem Content="11:00"/>
                                <ComboBoxItem Content="12:00"/>
                                <ComboBoxItem Content="13:00"/>
                                <ComboBoxItem Content="14:00"/>
                                <ComboBoxItem Content="15:00"/>
                                <ComboBoxItem Content="16:00"/>
                                <ComboBoxItem Content="17:00"/>
                                <ComboBoxItem Content="18:00"/>
                            </ComboBox>
<CheckBox Margin="0,0,0,8" x:Name="chkBlNow" Content="Bugünü kapsıyorsa hesapları hemen kapat / aç" IsChecked="True" Visibility="Collapsed"/>
<TextBlock x:Name="txtBlPeriod" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
</StackPanel>
</Border>
<Border Style="{DynamicResource Section}">
<StackPanel>
<TextBlock Text="2. Kullanıcı ekle" Style="{DynamicResource SectionTitle}"/>
<Button Margin="0,0,0,6" x:Name="btnBlOu" Tag="&#xE8B7;" Content="OU'lardan Ekle..." ToolTip="Ağaçtan bir veya birden fazla OU işaretleyin"/>
<CheckBox Margin="0,0,0,12" x:Name="chkBlSubtree" Content="Alt OU'lar dahil" IsChecked="True"/>
<DockPanel Margin="0,0,0,8">
<Button Margin="6,0,0,0" DockPanel.Dock="Right" x:Name="btnBlGroup" Tag="&#xE902;" Content="Gruptan Ekle"/>
<TextBox Margin="0" x:Name="txtBlGroup" AutomationProperties.Name="Grup adı" Tag="Grup adı"/>
</DockPanel>
<DockPanel Margin="0,0,0,8">
<Button Margin="6,0,0,0" DockPanel.Dock="Right" x:Name="btnBlSearch" Tag="&#xE721;" Content="Ara ve Ekle"/>
<TextBox Margin="0" x:Name="txtBlSearch" AutomationProperties.Name="Ad veya kullanıcı adı" Tag="Ad veya kullanıcı adı"/>
</DockPanel>
</StackPanel>
</Border>
<Border Style="{DynamicResource Section}">
<StackPanel>
<TextBlock Text="3. Nöbetçileri çıkar" Style="{DynamicResource SectionTitle}"/>
<TextBox Margin="0,0,0,6" x:Name="txtBlExclude" AutomationProperties.Name="Nöbetçi grubu (isteğe bağlı)" Tag="Nöbetçi grubu (isteğe bağlı)"/>
<Button Margin="0" x:Name="btnBlExclude" Tag="&#xE8F8;" Content="Grup Üyelerinin Seçimini Kaldır"
                        ToolTip="Yazılan grubun (ör. nöbetçiler) üyelerinin işaretini kaldırır"/>
</StackPanel>
</Border>
</StackPanel>
</ScrollViewer>
</Border>
<DockPanel Margin="16,0,16,16">
            
            
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <Button x:Name="btnBlClear" DockPanel.Dock="Right" Tag="&#xE74D;" Content="Listeyi Temizle" Style="{DynamicResource SubtleButton}" Margin="6,0,0,0"/>
                <Button x:Name="btnBlNone" DockPanel.Dock="Right" Content="Seçimi Kaldır" Style="{DynamicResource SubtleButton}" Margin="6,0,0,0"/>
                <Button x:Name="btnBlAll" DockPanel.Dock="Right" Content="Görünenleri Seç" Style="{DynamicResource SubtleButton}" Margin="6,0,0,0"/>
                
                
                <TextBox x:Name="txtBlFilter" AutomationProperties.Name="Listede ad, kullanıcı adı veya departmana göre filtrele" Tag="Listede ad, kullanıcı adı veya departmana göre filtrele"/>
            </DockPanel>
            <Border Style="{DynamicResource Card}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource LineSubtleBrush}" BorderThickness="0,0,0,1" Padding="18,10,18,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="Ad" Tag="sort:Name" Style="{StaticResource Hdr}"/>
                            <TextBlock Grid.Column="2" Text="Kullanıcı" Tag="sort:SamAccountName" Style="{StaticResource Hdr}"/>
                            <TextBlock Grid.Column="3" Text="Departman / Unvan" Tag="sort:DeptText" Style="{StaticResource Hdr}"/>
                            <TextBlock Grid.Column="4" Text="Mevcut izinler" Tag="sort:PeriodsText" Style="{StaticResource Hdr}"/>
                            <TextBlock Grid.Column="5" Text="Durum" Tag="sort:Note" Style="{StaticResource Hdr}"/>
                        </Grid>
                    </Border>
                    <Grid>
                        <TextBlock x:Name="txtBlEmpty" Text="Kullanıcı eklemek için yukarıdan OU, grup veya arama kullanın." Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40"/>
                        <ListBox x:Name="lstBl" SelectionMode="Single" BorderThickness="0" Background="Transparent" Padding="0,4" HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" Background="Transparent" CornerRadius="4" Padding="10,6" Margin="-10,-6,-10,-6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Selectable}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Cell}" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="2" Text="{Binding SamAccountName}" Style="{StaticResource Cell}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding DeptText}" ToolTip="{Binding DeptText}" Style="{StaticResource Cell}" Foreground="{DynamicResource TextMutedBrush}"/>
                                            <TextBlock Grid.Column="4" Text="{Binding PeriodsText}" ToolTip="{Binding PeriodsText}" Style="{StaticResource Cell}"/>
                                            <TextBlock Grid.Column="5" x:Name="Status" Text="{Binding Note}" ToolTip="{Binding Note}" Style="{StaticResource Cell}" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="Blocked">
                                            <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Done">
                                            <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Failed">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource DangerBgBrush}"/>
                                            <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>
        </DockPanel>
    </DockPanel>
</Window>
