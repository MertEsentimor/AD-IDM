<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OU Seçin" Width="640" Height="620" MinWidth="420" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <DockPanel>
        <Border Style="{DynamicResource DialogFooter}" DockPanel.Dock="Bottom">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="btnOuCancel" Content="İptal" IsCancel="True" MinWidth="100"/>
                <Button x:Name="btnOuOk" Margin="8,0,0,0" Content="Bu OU'da Oluştur" Style="{DynamicResource PrimaryButton}" IsDefault="True" MinWidth="150"/>
            </StackPanel>
                <TextBlock x:Name="txtOuDn" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
            </DockPanel>
        </Border>
        <DockPanel Margin="24,22,24,16">
            <TextBlock DockPanel.Dock="Top" x:Name="txtOuTitle" Text="Kullanıcı hangi OU'ya eklensin?" Style="{DynamicResource TitleText}" FontSize="20" Margin="0,0,0,14"/>
            <TextBox DockPanel.Dock="Top" x:Name="txtOuFilter" AutomationProperties.Name="OU filtrele" Tag="Filtrele: OU adı veya yolu" ToolTip="Filtre: OU adı veya yolu" Margin="0,0,0,10"/>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button x:Name="btnOuExpand" DockPanel.Dock="Left" Content="Tümünü Aç" Style="{DynamicResource SubtleButton}" Margin="0,0,6,0"/>
                <Button x:Name="btnOuCollapse" DockPanel.Dock="Left" Content="Tümünü Kapat" Style="{DynamicResource SubtleButton}" Margin="0,0,6,0"/>
                <Button x:Name="btnOuNone" DockPanel.Dock="Left" Content="Seçimi Temizle" Style="{DynamicResource SubtleButton}" Visibility="Collapsed"/>
                <CheckBox x:Name="chkOuSubtree" DockPanel.Dock="Right" Content="Alt OU'lar dahil" IsChecked="True" VerticalAlignment="Center" Visibility="Collapsed"
                          ToolTip="İşaretliyse seçilen OU ve altındaki tüm OU'lardaki kullanıcılar listelenir; değilse yalnız seçilen OU'dakiler"/>
                <TextBlock/>
            </DockPanel>
            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4">
                <TreeView x:Name="treeOu" BorderThickness="0" Padding="4"/>
            </Border>
        </DockPanel>
    </DockPanel>
</Window>
