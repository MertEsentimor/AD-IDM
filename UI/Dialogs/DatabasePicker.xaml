<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Posta Kutusu Veritabanı" Width="620" Height="520" MinWidth="440" MinHeight="340"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <DockPanel>
        <Border Style="{DynamicResource DialogFooter}" DockPanel.Dock="Bottom">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnDbCancel" Content="İptal" IsCancel="True" MinWidth="100"/>
                <Button x:Name="btnDbSkip" Margin="8,0,0,0" Content="Posta Kutusu Olmadan Devam"/>
                <Button x:Name="btnDbOk" Margin="8,0,0,0" Tag="&#xE715;" Content="Posta Kutusu Oluştur" Style="{DynamicResource PrimaryButton}" IsDefault="True" MinWidth="170"/>
            </StackPanel>
        </Border>
        <DockPanel Margin="24,22,24,16">
            <TextBlock DockPanel.Dock="Top" x:Name="txtDbTitle" Text="Posta kutusu hangi veritabanında oluşturulsun?" Style="{DynamicResource TitleText}" FontSize="20"/>
            <TextBlock DockPanel.Dock="Top" x:Name="txtDbInfo" Style="{DynamicResource SubtitleText}" Margin="0,6,0,14"
                       Text="Listeden bir veritabanı seçin. Otomatik seçimde Exchange, posta kutusunu uygun bir veritabanına yerleştirir."/>
            <ListBox x:Name="lstDb" Padding="0,4"/>
        </DockPanel>
    </DockPanel>
</Window>
