<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Silinmiş Cihaz Parolaları" Width="640" SizeToContent="Height" MaxHeight="760"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <DockPanel>
        <Border Style="{DynamicResource DialogFooter}" DockPanel.Dock="Bottom">
            <DockPanel>
                <Button x:Name="btnDsClose" DockPanel.Dock="Right" Content="Kapat" IsCancel="True" IsDefault="True" MinWidth="110"/>
                <TextBlock x:Name="txtDsStatus" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,12,0"/>
            </DockPanel>
        </Border>
        <StackPanel Margin="24,22,24,20">
            <TextBlock x:Name="txtDsTitle" Style="{DynamicResource TitleText}"/>
            <TextBlock Style="{DynamicResource HintText}" TextWrapping="Wrap" Margin="0,4,0,14"
                       Text="Değerler Geri Dönüşüm Kutusu'ndan okundu. Görüntüleme değişiklik günlüğüne yazıldı. Kopyalanan değer 60 saniye sonra panodan temizlenir."/>
            <ItemsControl x:Name="icDsSecrets" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,0,0,8">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Kopyala" Margin="8,0,0,0" VerticalAlignment="Bottom" Tag="{Binding Value}" IsEnabled="{Binding HasValue}"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                                    <TextBox Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </DockPanel>
</Window>
