<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kullanıcı Ekle" Width="1080" Height="780" MinWidth="860" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="24,20,24,12">
            <TextBlock Text="Yeni Active Directory kullanıcısı" Style="{DynamicResource TitleText}"/>
            <TextBlock Text="New-ADUser komutunu yapıştırıp 'Komuttan Doldur' deyin veya alanları elle doldurun. Komut çalıştırılmaz, yalnızca okunur."
                       Style="{DynamicResource SubtitleText}"/>
        </StackPanel>
        <Border Style="{DynamicResource DialogFooter}" DockPanel.Dock="Bottom">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="btnNuCancel" Content="Kapat" IsCancel="True" MinWidth="100"/>
                <Button x:Name="btnNuCreate" Margin="8,0,0,0" Tag="&#xE8FA;" Content="Kullanıcı Oluştur" Style="{DynamicResource PrimaryButton}" MinWidth="160"/>
            </StackPanel>
                <TextBlock x:Name="txtNuMessage" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Left" Width="340" Style="{DynamicResource SidePane}" BorderThickness="0,0,1,0">
<ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
<StackPanel Margin="12">
<Border Style="{DynamicResource Section}">
<StackPanel>
<TextBlock Text="Komuttan doldur" Style="{DynamicResource SectionTitle}"/>
<TextBlock Text="New-ADUser komutu" Style="{DynamicResource FieldLabel}"/>
<TextBox Height="260" x:Name="txtNuScript" AutomationProperties.Name="New-ADUser komutu" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="12" Margin="0,0,0,10"/>
<StackPanel Orientation="Horizontal">
<Button Margin="0,0,8,0" x:Name="btnNuParse" Tag="&#xE70F;" Content="Komuttan Doldur"/>
<Button x:Name="btnNuClear" Tag="&#xE894;" Content="Temizle" Style="{DynamicResource SubtleButton}"/>
</StackPanel>
</StackPanel>
</Border>
</StackPanel>
</ScrollViewer>
</Border>
<ScrollViewer VerticalScrollBarVisibility="Auto">
<StackPanel Margin="16,0,16,4">
<Border Style="{DynamicResource Section}">
<StackPanel>
<TextBlock Text="Kimlik" Style="{DynamicResource SectionTitle}"/>
<Grid>
<Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="Ad Soyad / Nesne adı (Name) *" Style="{DynamicResource FieldLabel}"/>
                                    <TextBox x:Name="txtNuName" AutomationProperties.Name="Ad Soyad / Nesne adı (Name) *"/>
                                </StackPanel>
<StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="Display Name" Style="{DynamicResource FieldLabel}"/>
                                    <TextBox x:Name="txtNuDisplayName" AutomationProperties.Name="Display Name"/>
                                </StackPanel>
<StackPanel Grid.Row="1" Grid.Column="0">
                                    <TextBlock Text="Ad (GivenName)" Style="{DynamicResource FieldLabel}"/>
                                    <TextBox x:Name="txtNuGivenName" AutomationProperties.Name="Ad (GivenName)"/>
                                </StackPanel>
<StackPanel Grid.Row="1" Grid.Column="2">
                                    <TextBlock Text="Soyad (Surname)" Style="{DynamicResource FieldLabel}"/>
                                    <TextBox x:Name="txtNuSurname" AutomationProperties.Name="Soyad (Surname)"/>
                                </StackPanel>
</Grid>
</StackPanel>
</Border>
<Border Style="{DynamicResource Section}">
<StackPanel>
<TextBlock Text="Oturum açma" Style="{DynamicResource SectionTitle}"/>
<Grid>
<Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Grid.RowDefinitions><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="SamAccountName *" Style="{DynamicResource FieldLabel}"/>
                                    <TextBox x:Name="txtNuSam" AutomationProperties.Name="SamAccountName *"/>
                                </StackPanel>
<StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="UserPrincipalName *" Style="{DynamicResource FieldLabel}"/>
                                    <TextBox x:Name="txtNuUpn" AutomationProperties.Name="UserPrincipalName *"/>
                                </StackPanel>
</Grid>
<TextBlock Text="E-posta (EmailAddress)" Style="{DynamicResource FieldLabel}"/>
<TextBox x:Name="txtNuEmail" AutomationProperties.Name="E-posta (EmailAddress)"/>
<TextBlock Text="Hedef OU (Path) - Oluştur dendiğinde ayrıca sorulur" Style="{DynamicResource FieldLabel}"/>
<TextBox x:Name="txtNuPath" AutomationProperties.Name="Hedef OU (Path) - Oluştur dendiğinde ayrıca sorulur"/>
</StackPanel>
</Border>
<Border Style="{DynamicResource Section}">
<StackPanel>
<TextBlock Text="Kuruluş" Style="{DynamicResource SectionTitle}"/>
<Grid>
<Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="Şirket (Company)" Style="{DynamicResource FieldLabel}"/>
                                    <TextBox x:Name="txtNuCompany" AutomationProperties.Name="Şirket (Company)"/>
                                </StackPanel>
<StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="Departman (Department)" Style="{DynamicResource FieldLabel}"/>
                                    <TextBox x:Name="txtNuDepartment" AutomationProperties.Name="Departman (Department)"/>
                                </StackPanel>
<StackPanel Grid.Row="1" Grid.Column="0">
                                    <TextBlock Text="Unvan (Title)" Style="{DynamicResource FieldLabel}"/>
                                    <TextBox x:Name="txtNuTitle" AutomationProperties.Name="Unvan (Title)"/>
                                </StackPanel>
<StackPanel Grid.Row="1" Grid.Column="2">
                                    <TextBlock Text="Ofis (Office)" Style="{DynamicResource FieldLabel}"/>
                                    <TextBox x:Name="txtNuOffice" AutomationProperties.Name="Ofis (Office)"/>
                                </StackPanel>
</Grid>
<TextBlock Text="Açıklama (Description)" Style="{DynamicResource FieldLabel}"/>
<TextBox x:Name="txtNuDescription" AutomationProperties.Name="Açıklama (Description)"/>
</StackPanel>
</Border>
<Border Style="{DynamicResource Section}">
<StackPanel>
<TextBlock Text="İletişim" Style="{DynamicResource SectionTitle}"/>
<Grid>
<Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Grid.RowDefinitions><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="Cep telefonu (MobilePhone)" Style="{DynamicResource FieldLabel}"/>
                                    <TextBox x:Name="txtNuMobile" AutomationProperties.Name="Cep telefonu (MobilePhone)"/>
                                </StackPanel>
<StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="İş telefonu (OfficePhone)" Style="{DynamicResource FieldLabel}"/>
                                    <TextBox x:Name="txtNuOfficePhone" AutomationProperties.Name="İş telefonu (OfficePhone)"/>
                                </StackPanel>
</Grid>
</StackPanel>
</Border>
<Border Style="{DynamicResource Section}">
                    <StackPanel>
                        <TextBlock Text="Parola ve hesap" Style="{DynamicResource SectionTitle}"/>
                        <Border Style="{DynamicResource SettingRow}" Margin="0,0,0,14">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="&#xE8BD;" Style="{DynamicResource Glyph}" Margin="0,0,16,0"/>
                                <CheckBox x:Name="chkNuSms" DockPanel.Dock="Right" Style="{DynamicResource ToggleSwitch}" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Parolayı oluştur ve hoş geldiniz SMS'i ile kullanıcıya gönder"/>
                                    <TextBlock x:Name="txtNuSmsInfo" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <StackPanel x:Name="pnlNuManual">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Parola *" Style="{DynamicResource FieldLabel}"/>
                                <PasswordBox x:Name="pwdNu" AutomationProperties.Name="Parola *"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Parola (tekrar) *" Style="{DynamicResource FieldLabel}"/>
                                <PasswordBox x:Name="pwdNuConfirm" AutomationProperties.Name="Parola (tekrar) *"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Button x:Name="btnNuGenerate" Tag="&#xE945;" Content="Güçlü Parola Oluştur" FontSize="12"/>
                            <TextBox x:Name="txtNuGenerated" AutomationProperties.Name="Oluşturulan parola" FontFamily="Cascadia Mono, Consolas" MinWidth="160" Margin="10,0,0,0" Visibility="Collapsed"/>
                            <Button x:Name="btnNuCopy" Tag="&#xE8C8;" Content="Kopyala" Style="{DynamicResource SubtleButton}" FontSize="12" Margin="4,0,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                        </StackPanel>
                        <CheckBox x:Name="chkNuMustChange" Content="Kullanıcı ilk oturum açışta parolasını değiştirmeli (ChangePasswordAtLogon)" IsChecked="True" Margin="0,0,0,10"/>
                        <CheckBox x:Name="chkNuEnabled" Content="Hesap etkin (Enabled)" IsChecked="True"/>
                    </StackPanel>
                </Border>
<Border Style="{DynamicResource Section}">
                    <StackPanel>
                        <TextBlock Text="Outsource bilgilendirme" Style="{DynamicResource SectionTitle}"/>
                        <Border Style="{DynamicResource SettingRow}" Margin="0,0,0,10">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="&#xE715;" Style="{DynamicResource Glyph}" Margin="0,0,16,0"/>
                                <CheckBox x:Name="chkNuOutsource" DockPanel.Dock="Right" Style="{DynamicResource ToggleSwitch}" VerticalAlignment="Center" AutomationProperties.Name="Outsource kullanıcı: bilgilendirme e-postası gönder"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Outsource kullanıcı: kurulum bilgilerini e-postayla gönder"/>
                                    <TextBlock x:Name="txtNuOutsourceInfo" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <StackPanel x:Name="pnlNuOutsource" Visibility="Collapsed">
                            <TextBlock x:Name="txtNuOutsourceTo" Text="Alıcı: formdaki E-posta (EmailAddress) alanı" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <TextBlock Text="CC (mail-config.json'dan gelir, burada değiştirebilirsiniz)" Style="{DynamicResource FieldLabel}"/>
                            <TextBox x:Name="txtNuOutsourceCc" AutomationProperties.Name="CC adresleri" Tag="adres1@contoso.com; adres2@contoso.com" Margin="0,0,0,3"/>
                            <TextBlock x:Name="txtNuOutsourceAttach" Style="{DynamicResource HintText}" TextWrapping="Wrap" Margin="0"/>
                        </StackPanel>
                    </StackPanel>
                </Border></StackPanel>
</ScrollViewer>
    </DockPanel>
</Window>
