<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parola Sıfırlama" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <DockPanel>
        <Border Style="{DynamicResource DialogFooter}" DockPanel.Dock="Bottom">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnPwdCancel" Content="İptal" IsCancel="True"/>
                <Button x:Name="btnPwdOk" Margin="8,0,0,0" Content="Parolayı Sıfırla" Style="{DynamicResource PrimaryButton}" IsDefault="True"/>
            </StackPanel>
        </Border>
        <StackPanel Margin="24,22,24,10">
            <TextBlock Text="Parola sıfırlama" Style="{DynamicResource TitleText}"/>
            <TextBlock x:Name="txtPwdUser" Style="{DynamicResource SubtitleText}" Margin="0,4,0,18"/>
            <Border Style="{DynamicResource SettingRow}" Margin="0,0,0,14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE8BD;" Style="{DynamicResource Glyph}" Margin="0,0,16,0"/>
                    <CheckBox x:Name="chkPwdSms" DockPanel.Dock="Right" Style="{DynamicResource ToggleSwitch}" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Parolayı oluştur ve SMS ile kullanıcıya gönder"/>
                        <TextBlock x:Name="txtPwdSmsInfo" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <StackPanel x:Name="pnlPwdManual">
                <TextBlock Text="Yeni parola" Style="{DynamicResource FieldLabel}"/>
                <PasswordBox x:Name="pwdNew" AutomationProperties.Name="Yeni parola"/>
                <TextBlock Text="Yeni parola (tekrar)" Style="{DynamicResource FieldLabel}"/>
                <PasswordBox x:Name="pwdConfirm" AutomationProperties.Name="Yeni parola (tekrar)"/>
            </StackPanel>
            <CheckBox x:Name="chkMustChange" Content="Kullanıcı bir sonraki oturum açışta parolasını değiştirmeli" IsChecked="True" Margin="0,0,0,10"/>
            <CheckBox x:Name="chkPwdUnlock" Content="Hesap kilitliyse kilidini aç" Margin="0,0,0,10"/>
            <TextBlock x:Name="txtPwdNote" Style="{DynamicResource HintText}" Margin="0,0,0,8"/>
            <TextBlock x:Name="txtPwdError" Foreground="{DynamicResource DangerBrush}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8"/>
        </StackPanel>
    </DockPanel>
</Window>
