<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exchange Kimlik Doğrulama" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <DockPanel>
        <Border Style="{DynamicResource DialogFooter}" DockPanel.Dock="Bottom">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnCredCancel" Content="İptal" IsCancel="True"/>
                <Button x:Name="btnCredOk" Margin="8,0,0,0" Tag="&#xE71B;" Content="Bağlan" Style="{DynamicResource PrimaryButton}" IsDefault="True"/>
            </StackPanel>
        </Border>
        <StackPanel Margin="24,22,24,10">
            <TextBlock Text="Exchange On-Premises bağlantısı" Style="{DynamicResource TitleText}"/>
            <TextBlock x:Name="txtCredServer" Style="{DynamicResource SubtitleText}"/>
            <TextBlock Text="Exchange yönetim rolü atanmış hesabın bilgilerini girin." Style="{DynamicResource InfoDetail}" Margin="0,14,0,16"/>
            <TextBlock Text="Kullanıcı adı (ETKİALANI\kullanici veya kullanici@etkialani)" Style="{DynamicResource FieldLabel}"/>
            <TextBox x:Name="txtCredUser" AutomationProperties.Name="Kullanıcı adı (ETKİALANI\kullanici veya kullanici@etkialani)"/>
            <TextBlock Text="Parola" Style="{DynamicResource FieldLabel}"/>
            <PasswordBox x:Name="pwdCred" AutomationProperties.Name="Parola"/>
            <TextBlock x:Name="txtCredError" Foreground="{DynamicResource DangerBrush}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,-6,0,10"/>
        </StackPanel>
    </DockPanel>
</Window>
